<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.proton.pass.ssh-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>rm -f "$HOME/.ssh/proton-pass-agent.sock"; exec /opt/homebrew/bin/pass-cli ssh-agent start --vault-name ssh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/pass-cli-ssh-agent.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/pass-cli-ssh-agent.log</string>
</dict>
</plist>
